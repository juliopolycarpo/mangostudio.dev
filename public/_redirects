# Bare /docs lands on the quickstart in each locale. Cloudflare evaluates these rules before
# asset serving and trailing-slash handling; targets end in "/" so they cannot loop.
# Permanent (301): verified in production with 302 first.
/docs /docs/quickstart/ 301
/docs/ /docs/quickstart/ 301
/en/docs /en/docs/quickstart/ 301
/en/docs/ /en/docs/quickstart/ 301
