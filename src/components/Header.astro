---
import { getLogoImages } from '@/components/logo-images';
import { GITHUB_URL, PALETTE_SHORTCUT } from '@/data/site';
import type { Lang, SiteContent } from '@/i18n/types';
import { routes } from '@/i18n/ui';
import Icon from './Icon.astro';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
  pathname: string;
  content: SiteContent;
  page: 'home' | 'releases' | 'docs';
}

const { lang, pathname, content: c, page } = Astro.props;

const { brand: brandLogo } = await getLogoImages();

const nav = [
  {
    label: c.nav.home,
    href: routes.home(lang),
    active: page === 'home',
    secondary: true,
  },
  {
    label: c.nav.features,
    href: `${routes.home(lang)}#features`,
    active: false,
    secondary: true,
  },
  {
    label: c.nav.releases,
    href: routes.releases(lang),
    active: page === 'releases',
  },
  {
    label: c.nav.docs,
    href: routes.doc(lang, 'quickstart'),
    active: page === 'docs',
  },
];
---

<header class="site-header">
  <a
    class="brand"
    href={routes.home(lang)}
    aria-label="MangoStudio"
  >
    <img
      src={brandLogo.src}
      srcset={brandLogo.srcset}
      alt=""
      width="28"
      height="28"
      class="brand-logo"
      decoding="async"
    />
    <span class="brand-name">Mango<span class="brand-dim">Studio</span></span>
  </a>

  <nav class="nav" aria-label={c.nav.label}>
    {
      nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { 'is-active': item.active, 'is-secondary': item.secondary }]}
          aria-current={item.active ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="spacer"></div>

  <button
    type="button"
    class="search-btn"
    data-cmdk-open
    data-enhance="cmdk"
    data-enhance-reserve
    aria-haspopup="dialog"
  >
    <Icon name="search" size={14} />
    <span class="search-label" aria-hidden="true">{c.header.search}</span>
    <span class="visually-hidden">{c.header.searchLabel}</span>
    <kbd
      data-cmdk-hint
      data-hint-mac={PALETTE_SHORTCUT.mac}
      data-hint-other={PALETTE_SHORTCUT.other}>{PALETTE_SHORTCUT.fallback}</kbd
    >
  </button>

  <ThemeToggle label={c.header.theme} />
  <LangToggle lang={lang} pathname={pathname} content={c} />

  <a class="gh-link" href={GITHUB_URL} target="_blank" rel="noopener" aria-label={c.header.github}>
    <Icon name="github" size={16} />
    <span class="gh-star" aria-hidden="true">★</span>
    <span class="gh-label">{c.header.star}</span>
  </a>

  <a
    class="btn btn-primary header-cta"
    href={routes.doc(lang, 'quickstart')}
  >
    {c.header.cta}
  </a>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 13px 24px;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text);
  }

  .brand-logo {
    display: block;
  }

  .brand-name {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .brand-dim {
    color: var(--text-2);
    font-weight: 500;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: 14px;
  }

  .nav-link {
    position: relative;
    font-size: 13.5px;
    color: var(--text-2);
    text-decoration: none;
    padding: 8px 11px;
    border-radius: 8px;
    font-weight: 500;
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link.is-active {
    color: var(--text);
  }

  .nav-link.is-active::after {
    content: "";
    position: absolute;
    left: 11px;
    right: 11px;
    bottom: 2px;
    height: 2px;
    border-radius: 2px;
    background: var(--mango);
  }

  .spacer {
    flex: 1;
  }

  .search-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    cursor: pointer;
    color: var(--text-3);
    font-family: inherit;
    font-size: 13px;
    padding: 7px 10px 7px 12px;
    border-radius: 9px;
    min-width: 190px;
  }

  .search-btn:hover {
    border-color: color-mix(in srgb, var(--mango) 45%, var(--border));
  }

  .search-label {
    flex: 1;
    text-align: left;
  }

  kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 1px 5px;
    color: var(--text-3);
  }

  .gh-link {
    display: flex;
    align-items: center;
    gap: 7px;
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 7px 11px;
    color: var(--text);
    font-size: 13px;
    font-weight: 500;
  }

  .gh-link:hover {
    border-color: color-mix(in srgb, var(--mango) 45%, var(--border));
  }

  .gh-star {
    font-size: 12px;
    line-height: 1;
    color: var(--accent-text);
  }

  .gh-label {
    font-size: 13px;
    color: var(--text-2);
  }

  .header-cta {
    padding: 8px 16px;
    font-size: 13.5px;
  }

  /* Every control keeps its natural size: the header never squeezes a control below its
     content. Room is made by hiding optional content per breakpoint instead. */
  .brand,
  .nav,
  .search-btn,
  .gh-link,
  .header-cta {
    flex-shrink: 0;
  }

  .search-btn svg {
    flex-shrink: 0;
  }

  .search-btn,
  .gh-link,
  .header-cta,
  kbd {
    white-space: nowrap;
  }

  /* The full desktop header only just fits above 1080px, so tighten it until there is
     comfortable room. */
  @media (min-width: 1081px) and (max-width: 1279px) {
    .site-header {
      gap: 12px;
    }
    .search-btn {
      min-width: 0;
    }
  }

  /* Tablet: drop the labels and the secondary links, keep Docs and Releases. */
  @media (max-width: 1080px) {
    .site-header {
      gap: 12px;
    }
    .nav {
      margin-left: 0;
      gap: 0;
    }
    .nav-link {
      font-size: 13px;
      padding: 8px 6px;
    }
    .nav-link.is-active::after {
      left: 6px;
      right: 6px;
    }
    .nav-link.is-secondary,
    .search-label,
    .gh-star,
    .gh-label {
      display: none;
    }
    .search-btn {
      min-width: 0;
    }
  }

  /* The server-rendered hint ("Ctrl K / ⌘K") is wider than the platform hint JavaScript
     swaps in, so the narrowest tablets need the phone spacing to stay inside the viewport
     without JavaScript. */
  @media (max-width: 860px) {
    .site-header {
      gap: 8px;
    }
  }

  @media (max-width: 720px) {
    .site-header {
      padding: 11px 16px;
      /* Avoid the per-scroll-frame backdrop blur repaint on phones; a near-opaque
         background keeps the sticky header legible at a fraction of the paint cost. */
      background: color-mix(in srgb, var(--bg) 94%, transparent);
      backdrop-filter: none;
    }
    .nav,
    .header-cta {
      display: none;
    }
  }

  /* Phones have no keyboard shortcut, and the hint is what would push the header past the
     viewport. Keep it in the accessible name but out of the layout. */
  @media (max-width: 479px) {
    .search-btn {
      position: relative;
    }
    .search-btn kbd {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      border: 0;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }

  /* Below 390px the wordmark no longer fits next to the four controls; the logo link keeps
     its aria-label. */
  @media (max-width: 389px) {
    .brand-name {
      display: none;
    }
  }
</style>
