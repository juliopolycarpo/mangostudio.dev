{
  "name": "mangostudio.dev",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "Marketing and docs website for MangoStudio — your local AI studio in a single binary.",
  "author": "Julio Polycarpo",
  "homepage": "https://mangostudio.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliopolycarpo/mangostudio.dev.git"
  },
  "bugs": {
    "url": "https://github.com/juliopolycarpo/mangostudio.dev/issues"
  },
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "bun run typecheck && biome check . && dprint check",
    "qa": "bun run check && bun run test && bun run build && bun run smoke:dist && bun run audit:static && bun run audit:payloads && bun run labels:check && bun run cloudflare:dry-run",
    "typecheck": "astro check && bun run typecheck:native",
    "typecheck:native": "astro sync && bun ./node_modules/typescript-native/bin/tsc --noEmit",
    "lint": "biome check .",
    "test": "bun ./scripts/run-tests.ts",
    "fix": "biome check --write . && dprint fmt",
    "format": "biome format --write . && dprint fmt",
    "audit:static": "bun ./scripts/audit-static-site.ts",
    "audit:payloads": "bun ./scripts/report-static-payloads.ts --check",
    "smoke:dist": "bun ./scripts/smoke-dist.ts",
    "test:e2e": "bun --bun playwright test",
    "report:payloads": "bun ./scripts/report-static-payloads.ts",
    "sync:docs": "bun ./scripts/sync-docs.ts",
    "smoke:production": "bun ./scripts/smoke-production-url.ts",
    "labels:check": "bun ./scripts/sync-labels.ts --dry-run",
    "labels:sync": "bun ./scripts/sync-labels.ts",
    "cloudflare:dry-run": "wrangler deploy --dry-run --outdir .wrangler-dry",
    "deploy": "astro build && wrangler deploy",
    "deploy:dry-run": "bun run build && bun run cloudflare:dry-run",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@biomejs/biome": "^2.5.15",
    "@dprint/markdown": "^0.26.0",
    "@dprint/toml": "^0.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "astro": "^7.3.8",
    "dprint": "^0.62.0",
    "lefthook": "^2.2.1",
    "typescript": "~6.0.3",
    "typescript-native": "npm:typescript@7.0.2",
    "wrangler": "^4.149.0"
  }
}
